# GCC Social Listening Pipeline - Environment Configuration Template
# Copy this file to .env and fill in your keys if using real APIs or real AWS S3.
# The pipeline defaults to offline mock mode (MOCK_S3=true, LLM_PROVIDER=mock),
# which allows 100% of pipeline stages, tests, and dashboards to run out of the box.

# Environment Mode: development | test | production
APP_ENV=development

# AWS S3 Storage Configuration
# Set MOCK_S3=false only when you wish to write to real AWS S3 (requires permission & valid credentials)
MOCK_S3=true
USE_LOCALSTACK=false
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=me-central-1
S3_BUCKET_NAME=gcc-social-listening-bucket
# S3_ENDPOINT_URL=http://localhost:4566  # Uncomment if using LocalStack or MinIO

# API Ingestion Keys
# YouTube Data API v3 key (Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# LLM Classification Provider: gemini | openai | mock
# Use "mock" for zero-cost offline deterministic execution.
# Use "gemini" or "openai" for live LLM queries.
LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_CACHE_ENABLED=true

# Logging
LOG_LEVEL=INFO
